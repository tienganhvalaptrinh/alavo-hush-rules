{
  "$id": "service.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "preselected", "components", "measurements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": { "type": "integer", "minimum": 1 },
    "preselected": { "type": "boolean" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/component" }
    },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurement" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "description", "packages", "status", "enabledByDefault", "rules"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "kind": { "enum": ["app", "web", "webview", "chat"] },
        "label": { "$ref": "common.schema.json#/$defs/localizedText" },
        "description": { "$ref": "common.schema.json#/$defs/localizedText" },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/packageName" }
        },
        "status": { "enum": ["stable", "experimental", "unmeasured"] },
        "enabledByDefault": { "type": "boolean" },
        "rules": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "action", "scope"],
      "properties": {
        "domain": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/hostname" }, { "const": "*" }]
        },
        "action": { "$ref": "common.schema.json#/$defs/action" },
        "scope": {
          "oneOf": [
            { "const": "all" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/packageName" }
            }
          ]
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "appVersion", "date"],
      "properties": {
        "package": { "$ref": "common.schema.json#/$defs/packageName" },
        "appVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "date": { "$ref": "common.schema.json#/$defs/isoDate" }
      }
    }
  }
}
